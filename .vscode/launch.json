    "version": "0.2.0",
    "configurations": [
    {
        "name": "ruby_start",
        "type": "cppdbg",
        "request": "launch",
        "program": "/home/radxa/ruby/ruby_start",
        "args": ["-debug", "-ignoredrivers"],
        "stopAtEntry": true,
        "cwd": "${fileDirname}",
        "environment": [],
        "externalConsole": false,
        "MIMode": "gdb",
        "setupCommands": [
            {
                "description": "Enable pretty-printing for gdb",
                "text": "-enable-pretty-printing",
                "ignoreFailures": true
            },
            {
                "description": "Set Disassembly Flavor to Intel",
                "text": "-gdb-set disassembly-flavor intel",
                "ignoreFailures": true
            }
        ]
    },
